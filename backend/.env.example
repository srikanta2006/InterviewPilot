# InterviewPilot Backend Environment Configuration (Example)
# Copy this file to .env and configure local values as needed.
# DO NOT commit real API keys or sensitive credentials to version control.

# Groq API configuration (Free tier API key from https://console.groq.com)
GROQ_API_KEY=gsk_placeholder_replace_with_actual_key

# Application runtime settings
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000

# CORS settings (comma-separated allowed origins for frontend)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Persistence paths
DATABASE_URL=sqlite:///./interviewpilot.db
CHROMA_PERSIST_DIRECTORY=./chroma_db
